{
  "name": "leads-prospect",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:sheet": "tsx --env-file-if-exists=.env.local scripts/check-sheet.ts",
    "migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "import": "tsx --env-file-if-exists=.env.local scripts/import.ts"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "google-auth-library": "^11.3.4",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
